# Projeto Supabase "Torcida Online" (Settings → API). A chave publicável pode ir para o navegador.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Stripe, conta "Torcida Online" (Desenvolvedores → Chaves de API). Só a publicável fica aqui; a secreta
# (STRIPE_SECRET_KEY) e a do webhook (STRIPE_WEBHOOK_SECRET) ficam nos Secrets das Edge Functions do Supabase.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
